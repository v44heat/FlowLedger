// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  transactions Transaction[]
  budgets      Budget[]
  imports      ImportBatch[]

  @@map("users")
}

model Transaction {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  transactionCode String   @unique @map("transaction_code")
  transactionDate DateTime @map("transaction_date")
  merchantName    String   @map("merchant_name")
  amount          Float
  transactionType String   @map("transaction_type") // DEBIT | CREDIT
  category        String   @default("Uncategorized")
  confidenceScore Float    @default(0) @map("confidence_score")
  rawDescription  String   @map("raw_description")
  isManual        Boolean  @default(false) @map("is_manual")
  importBatchId   String?  @map("import_batch_id")
  createdAt       DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id])

  @@index([userId, transactionDate])
  @@index([userId, category])
  @@map("transactions")
}

model MerchantCategory {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  merchantName   String   @map("merchant_name")
  category       String
  timesConfirmed Int      @default(1) @map("times_confirmed")
  lastSeen       DateTime @default(now()) @map("last_seen")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, merchantName])
  @@map("merchant_categories")
}

model Budget {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  category     String
  monthlyLimit Float    @map("monthly_limit")
  month        Int // 1-12
  year         Int
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month, year])
  @@map("budgets")
}

model ImportBatch {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  fileName     String   @map("file_name")
  rowsTotal    Int      @map("rows_total")
  rowsImported Int      @map("rows_imported")
  rowsSkipped  Int      @map("rows_skipped")
  status       String   @default("pending") // pending | processing | done | failed
  createdAt    DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("import_batches")
}
